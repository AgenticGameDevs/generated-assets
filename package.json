{
  "name": "generated-assets",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/catalog.mjs && node scripts/build-docs.mjs && node scripts/build-site.mjs",
    "test": "node --test tests/*.test.mjs",
    "mcp": "node mcp/server.mjs",
    "new-asset": "node scripts/add-asset.mjs",
    "export:models": "node scripts/export-models.mjs",
    "catalog": "node scripts/catalog.mjs",
    "verify": "node scripts/verify.mjs",
    "convert": "node scripts/convert-model.mjs",
    "validate:gltf": "node scripts/validate-gltf.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "1.63.0",
    "esbuild": "0.25.12",
    "fflate": "0.8.3",
    "gltf-validator": "2.0.0-dev.3.10",
    "markdown-it": "15.0.2",
    "meshoptimizer": "1.2.0",
    "prettier": "3.9.6",
    "sharp": "0.35.4",
    "three": "0.185.1"
  }
}
